# App
PORT=5050
NODE_ENV=development
ALLOWED_ORIGINS=https://webdev-coursework.com,https://api.webdev-coursework.com,http://localhost:3000,http://localhost:5050

# Database (single source of truth)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webdev_coursework
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Auth / guards
QUIZ_SECRET_KEY=change_me_quiz_secret
QUIZ_ANSWERS_JWT_SECRET=change_me_quiz_jwt_secret
QUIZ_ANSWERS_JWT_TTL=1h
QUIZ_JWT_ISSUER=webdev-coursework
QUIZ_JWT_AUDIENCE=webdev-coursework-users
ADMIN_API_KEY=change_me_admin_key

# Global abuse protection is always enabled. Apply database migrations first.
# Optional dedicated >=32-character secret; otherwise uses OWNER_SESSION_SECRET
# or QUIZ_ANSWERS_JWT_SECRET. Use the same secret on every replica.
API_THROTTLE_SECRET=
# Trust only infrastructure proxy CIDRs outside Heroku; empty means no proxy trust.
# Heroku DYNO deployments continue to trust exactly one router hop.
TRUST_PROXY_CIDRS=

# Swagger: enabled in development; disabled by default in production.
# Explicit production enablement also requires separate Basic credentials.
SWAGGER_ENABLED=
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Optional release label for local/dev UI
RELEASE_VERSION=local-dev

# Accounts and anonymous QR analytics (disabled until configured)
QR_ANALYTICS_ENABLED=false
# Optional: leave empty to use the existing PostgreSQL for sessions/queues
REDIS_URL=
OWNER_ALLOWED_ORIGINS=http://127.0.0.1:3000
OWNER_SESSION_SECRET=
OWNER_PASSWORD_HASH=
# Optional public GitHub OAuth; GITHUB_OWNER_ID identifies the primary admin: configure all four or leave all empty
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER_ID=60080971
GITHUB_CALLBACK_URL=

# Authentication email delivery: existing SMTP; no external queue purchase needed
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Web Engineering Portfolio
SMTP_USE_SSL=false
SMTP_REQUIRE_TLS=true

# Dedicated server-only TOTP key: random 32 bytes in canonical Base64.
# Preserve existing keys; losing a key prevents verification of enrolled accounts.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_ID=v1
MFA_PREVIOUS_ENCRYPTION_KEY=
MFA_PREVIOUS_ENCRYPTION_KEY_ID=

# Security domain: Cloudflare Turnstile protects password login, registration and API docs.
# Configure all three settings; partial configuration rejects protected requests.
# Secret stays server-side; login-options returns only the public site key.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Example: webdev-coursework.com,www.webdev-coursework.com,api.webdev-coursework.com,localhost,127.0.0.1
